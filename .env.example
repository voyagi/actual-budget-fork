# Enable Banking Configuration
# Get app_id from enablebanking.com/cp after registering your application
ENABLE_BANKING_APP_ID=your-application-id-here

# Path where the RSA private key is mounted in the container
# Host file goes in ./secrets/eb_private.pem (gitignored)
ENABLE_BANKING_KEY_PATH=/run/secrets/eb_private.pem

# API base URL - same for sandbox and production
ENABLE_BANKING_BASE_URL=https://api.enablebanking.com

# NODE_ENV: set to 'production' for Phase 1. Dev mode (nodemon) will be configured in Phase 2.
NODE_ENV=production

# Port the sync-server listens on inside the container
ACTUAL_PORT=5006

# Port exposed on the host
SYNC_PORT=5006

# ── Caddy (LAN HTTPS) ──────────────────────────────────────
# LAN hostname for Caddy. Must resolve on your network (add to hosts file or local DNS).
# Default: localhost (browser will show cert warning unless CA is trusted)
CADDY_HOST=actual.local

# ── Cloudflare Tunnel (phone/iOS HTTPS) ────────────────────
# Create tunnel at: one.dash.cloudflare.com > Networks > Tunnels > Create
# Set public hostname service to: http://sync-server:5006
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here

# ── CORS (production) ──────────────────────────────────────
# Set to the Cloudflare Tunnel public URL if phone access shows CORS errors.
# Usually not needed (web app is served same-origin by sync-server).
# ACTUAL_CORS_ORIGIN=https://actual.yourdomain.com
